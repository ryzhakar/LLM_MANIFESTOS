#!/bin/bash
# Run the unharness copy bundled with this plugin, so skill text and tool never differ.
# UNHARNESS_FROM overrides the source (a path or a git URL), for testing a working tree or a release.
set -euo pipefail
command -v uv >/dev/null 2>&1 || { echo "unharness launcher: uv is not installed" >&2; exit 1; }
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FROM="${UNHARNESS_FROM:-$ROOT/unharness}"
if [ -d "$FROM" ]; then
  exec uvx --no-cache --from "$FROM" --with-editable "$FROM" unharness "$@"
fi
exec uvx --from "$FROM" unharness "$@"
